# Server Configuration
PORT=3000
NODE_ENV=development

# Database
MONGO_URI=mongodb://localhost:27017/studysphere

# Authentication
JWT_SECRET=your_jwt_secret_key_here

# Frontend URL (CORS/Socket.io)
FRONTEND_URL=http://localhost:5173

# Email Service (currently stubbed to console.log)
EMAIL_SERVICE=Gmail
NODEMAILER_EMAIL_APP=your_email@gmail.com
NODEMAILER_APP_PASSWORD=your_app_password

# LiveKit Configuration (if applicable)
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=your_livekit_url
